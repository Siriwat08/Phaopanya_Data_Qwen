/**
 * ============================================================================
 * PATCH TASK44-1 — 00_CleanService.gs : cleanThai เพิ่ม 2 กฎ (dual placement)
 * วางแทนฟังก์ชัน cleanThai ทั้งฟังก์ชันเดิมในไฟล์ 00_CleanService.gs
 * ----------------------------------------------------------------------------
 * เหตุผล (ผลตรวจ 2026-09-22, PPY_LMDS_SCGJWD.csv 11,961 แถว):
 *   - "เขตเขต/แขวงแขวง" ใน ADDR_CLEAN 6,449 แถว (ใน RAW 6,998) เกิดจากต้นทาง
 *     ซ้อนคำนำหน้าเขตการปกครอง แล้ว clean เดิมไม่มีกฎรวม
 *   - PII เบอร์โทรใน NAME_CLEAN ~834 แถว (เบอร์จริง ~296 + รหัส DN/พนักงาน ~538)
 *     หลุดมาเพราะกฎเดิมตัดเฉพาะ "โทร." นำหน้า
 *
 * ★ กฎ regex ต้องเทียบเท่าชุด Python (scripts/master_cleanup/cleanup_lib.py):
 *   DUP_PREFIX  = (เขต|แขวง|ตำบล|อำเภอ|จังหวัด)\s*\1+
 *   PHONE       = 0\d{1,2}[\s\-.]?\d{3,4}[\s\-.]?\d{3,4} (9-10 หลัก มี/ไม่มีขีด,
 *                  มี guard ไม่ตัดกลางเลขยาว)
 *   LOOSE       = \d{7,} | \d(?:[\s\-./]\d){6,}     (เลขยาว/คั่นปะในชื่อ)
 *   (ฝั่ง GAS เขียนด้วย capture group แทน lookbehind เพื่อรองรับทุก runtime)
 *
 * ★★ ต้องวางพร้อมกับผลล้างเฟส 1 ในวันเดียวกัน (dual placement):
 *   ถ้าวางฝั่งเดียว key ของ SOURCE ใหม่ (makeKey) กับ MASTER เดิมจะเบี่ยงกัน
 *   → ปุ่ม 1 จะ upsert แถวใหม่แทนที่จะ merge — เกิด duplicate
 * ============================================================================
 */

/** แปลงเลขไทยเป็นเลขอาหรับ (เดิม — ไม่แก้) */
function cleanThaiDigits_(s) {
  const map = { '๐': '0', '๑': '1', '๒': '2', '๓': '3', '๔': '4',
                '๕': '5', '๖': '6', '๗': '7', '๘': '8', '๙': '9' };
  return s.replace(/[๐-๙]/g, function (c) { return map[c]; });
}

/**
 * ล้างเท็กซ์ไทยเป็นมาตรฐาน (PATCH TASK44-1)
 * ลำดับ: วงเล็บ → โทร. → คำนำหน้าชื่อ → เลขไทย → ★เบอร์โทร → ★คำนำหน้าซ้ำ
 *        → สัญลักษณ์ → lowercase รวมช่องว่าง
 */
function cleanThai(s) {
  if (s === undefined || s === null) return '';
  let str = String(s).trim();
  if (!str) return '';
  // [เดิม] ตัดครึ่งวงเล็บ/วงเล็บพร้อมเนื้อหา (ชั้นเดียว)
  str = str.replace(/[\[\(][^\]\)]*[\]\)]/g, ' ');
  // [เดิม] ตัด "โทร." พร้อมเลขที่ตามหลัง
  str = str.replace(/โทร\.?\s*\d[\d\- ๐-๙]{3,}/g, ' ');
  // [เดิม] ตัดคำนำหน้าชื่อคน: นาย/นาง/นางสาว/คุณ/ดร.
  str = str.replace(/^(นาย|นาง|นางสาว|คุณ|ดร\.?)\s+/g, ' ');
  // [เดิม] แปลงเลขไทย→อาหรับ (ต้องมาก่อนกฎเบอร์ ถึงจะจับเบอร์เลขไทยได้)
  str = cleanThaiDigits_(str);

  // ★ ใหม่ [TASK44-1a] ตัดเบอร์โทร 2 แบบ — หลังแปลงเลข ก่อนตัดสัญลักษณ์
  //   1) รูปแบบมาตรฐาน 0x-xxx-xxxx / 0x xxx xxxx / 0xxxxxxx9-10 หลัก
  var __s0 = str;
  str = str.replace(/(^|[^\d])(0\d{1,2}[\s\-\.]?\d{3,4}[\s\-\.]?\d{3,4})(?!\d)/g, '$1 ');
  //   2) แบบหลวม: ตัวเลขติดกัน 7 หลักขึ้นไป หรือคั่นด้วย - วรรค . / อย่างน้อย 7 กลุ่ม
  //      (จับรหัส DN/พนักงานที่ปะมากับชื่อ — ไม่กระทบบ้านเลขที่ปกติ)
  str = str.replace(/(^|[^\d])(\d{7,}|\d(?:[\s\-\.\/]\d){6,})(?!\d)/g, '$1 ');
  //   3) ลบเศษคั่นท้าย (เช่น 'คุณpang /') เฉพาะเมื่อมีเบอร์ถูกตัดจริง — เทียบเท่าชุด Python
  if (str !== __s0) str = str.replace(/[\s\/\-]+$/, '');

  // ★ ใหม่ [TASK44-1b] รวมคำนำหน้าเขตการปกครองที่ซ้ำ:
  //   เขตเขต/เขต เขต → เขต | แขวงแขวง → แขวง | ตำบล ตำบล → ตำบล | ฯลฯ
  //   (ทำซ้ำได้ idempotent: รันสองรอบผลลัพธ์เหมือนรอบเดียว)
  str = str.replace(/(เขต|แขวง|ตำบล|อำเภอ|จังหวัด)\s*\1+/g, '$1');

  // [เดิม] ตัดสัญลักษณ์ เหลือเฉพาะไทย+อาหรับ+อังกฤษ+ช่องว่าง+ยัติภังค์+สแลช
  str = str.replace(/[^A-Za-z0-9ก-๙ \-\/]/g, ' ');
  // [เดิม] รวมช่องว่างซ้ำ + lowercase
  return str.toLowerCase().replace(/\s+/g, ' ').trim();
}

